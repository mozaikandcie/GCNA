# Équivalent de vercel.json pour Hostinger (Apache / LiteSpeed)

# Forcer HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Assets : cache 1 an
  <FilesMatch "^.*$">
    <If "%{REQUEST_URI} =~ m#^/assets/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/(css|js)/#">
      Header set Cache-Control "public, max-age=0, must-revalidate"
    </ElseIf>
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Ne pas servir les fichiers cachés / de config
<FilesMatch "^(\.git|\.htaccess|vercel\.json|README\.md)">
  Require all denied
</FilesMatch>
