# Hostinger (Apache / LiteSpeed). Le cache est réglé dans assets/.htaccess, css/.htaccess et js/.htaccess.

RewriteEngine On

# www -> gcna.fr (une seule adresse pour Google et pour le preloader)
RewriteCond %{HTTP_HOST} ^www\.gcna\.fr$ [NC]
RewriteRule ^ https://gcna.fr%{REQUEST_URI} [L,R=301]

# Forcer HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # À activer une fois le HTTPS confirmé et stable :
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Fichiers non publics
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
